{
  "name": "@robyrew/chat-converter",
  "version": "0.1.0",
  "description": "Converts chat exports (Telegram Desktop HTML/JSON, WhatsApp) through one lossless canonical model into other formats, including the package Telegram imports.",
  "license": "Apache-2.0",
  "author": "RobyRew (https://github.com/RobyRew)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobyRew/chat-converter.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model/index.ts",
    "./worker": "./src/worker/worker.ts",
    "./transforms": "./src/engine/transforms.ts",
    "./richtext": "./src/engine/richtext.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
