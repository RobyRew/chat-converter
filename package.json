{
  "name": "@robyrew/chat-converter",
  "version": "0.3.0",
  "description": "Converts chat exports (Telegram Desktop, WhatsApp, Instagram, Facebook Messenger, Snapchat, VSCO, Hinge) through UniversalChat, one lossless versioned format, into other formats, including the package Telegram imports.",
  "license": "Apache-2.0",
  "author": "RobyRew (https://github.com/RobyRew)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobyRew/chat-converter.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model/index.ts",
    "./worker": "./src/worker/worker.ts",
    "./transforms": "./src/engine/transforms.ts",
    "./richtext": "./src/engine/richtext.ts",
    "./targets": "./src/targets/index.ts",
    "./browser": "./src/browser/index.ts",
    "./node": "./src/node/index.ts",
    "./ui": "./src/ui/index.ts",
    "./ui/icons": "./src/ui/icons.ts",
    "./ui/styles.css": "./src/ui/styles.css"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json && tsc --noEmit -p tsconfig.model.json",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json && tsc --noEmit -p tsconfig.model.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:real": "vitest run test/real",
    "cli": "tsx src/cli/main.ts"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.24.0",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "htmlparser2": "^12.0.0"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
