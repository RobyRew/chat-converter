---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import '@robyrew/chat-converter/ui/styles.css';
---

<Base
  title="Chat Converter — move your chats between apps"
  description="Convert a chat export from Telegram, WhatsApp, Instagram, Facebook, Snapchat, VSCO or Hinge into what another app imports, entirely in your browser."
  page="convert"
>
  <section class="hero" data-hero>
    <p class="hero__eyebrow"><Icon name="lock" size={14} /> Private · runs in your browser</p>
    <h1>Move your chats <span class="hero__grad">between apps</span></h1>
    <p class="hero__lead">
      Turn a Telegram, WhatsApp, Instagram, Facebook, Snapchat, VSCO or Hinge export into the package Telegram
      imports, a lossless UniversalChat archive, a web page and more.
    </p>
  </section>

  <div class="app-host">
    <chat-converter-app></chat-converter-app>
  </div>
</Base>

<script>
  import { gsap } from 'gsap';
  import { defineChatConverter } from '@robyrew/chat-converter/ui';

  defineChatConverter();

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.from('.hero > *', { y: 14, opacity: 0, duration: 0.7, stagger: 0.07, ease: 'power3.out', clearProps: 'all' });
    gsap.from('.cc-start > *', { y: 18, opacity: 0, duration: 0.7, delay: 0.18, stagger: 0.08, ease: 'power3.out', clearProps: 'all' });
  }
</script>
