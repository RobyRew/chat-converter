---
// The converter's icon set (one source: @robyrew/chat-converter/ui/icons), rendered at build time.
import { ICON_PATHS, type IconName } from '@robyrew/chat-converter/ui/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 18, class: cls = '' } = Astro.props;
---

<svg
  class:list={['icon', cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={ICON_PATHS[name]}
/>
