---
import Icon from './Icon.astro';
import { SOURCE_URL } from '../site';
---

<footer class="site-foot">
  <div class="site-foot__inner">
    <p class="site-foot__privacy">
      <Icon name="shield" size={16} />
      Exports are read and converted in your browser. Nothing is uploaded, and the site loads no analytics.
    </p>
    <nav class="site-foot__links" aria-label="Footer">
      <a href="/">Convert</a>
      <a href="/formats">Formats</a>
      <a href="/guide">Guide</a>
      <a href={SOURCE_URL} rel="noopener">Source · Apache-2.0</a>
    </nav>
  </div>
</footer>

<style>
  .site-foot {
    margin-top: 3rem;
    border-top: 1px solid var(--hair-soft);
  }
  .site-foot__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    max-width: var(--site-max);
    margin-inline: auto;
    padding: 1.4rem var(--gutter) calc(1.6rem + env(safe-area-inset-bottom));
    font-size: 0.84rem;
    color: var(--ink-3);
  }
  .site-foot__privacy {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }
  .site-foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
  }
  .site-foot__links a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .site-foot__links a:hover {
    color: var(--ink);
  }
</style>
